{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "approved",
        "denied"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "schema_version": {
      "const": "aegis.approval/v1",
      "default": "aegis.approval/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_ref": {
      "maxLength": 2048,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9+.-]*://\\S+$",
      "title": "Subject Ref",
      "type": "string"
    }
  },
  "required": [
    "id",
    "case_id",
    "subject_ref",
    "requested_at",
    "expires_at"
  ],
  "title": "Approval",
  "type": "object"
}
