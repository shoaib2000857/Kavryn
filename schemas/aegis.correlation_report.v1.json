{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "description": "A content hash used to content-address an artifact or record.\n\nOnly sha256 is accepted for this change; widening the algorithm set\nlater is additive and does not require a schema version bump.",
      "properties": {
        "algorithm": {
          "default": "sha256",
          "pattern": "^sha256$",
          "title": "Algorithm",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "title": "Digest",
      "type": "object"
    },
    "InvestigationHypothesis": {
      "additionalProperties": false,
      "description": "Evidence-linked lead, not a confirmed incident or causal finding.",
      "properties": {
        "case_id": {
          "maxLength": 64,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "deployment_source_digest": {
          "$ref": "#/$defs/Digest"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9+.-]*://\\S+$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_digest": {
          "$ref": "#/$defs/Digest"
        },
        "finding_rule_id": {
          "minLength": 1,
          "title": "Finding Rule Id",
          "type": "string"
        },
        "finding_tool": {
          "enum": [
            "semgrep",
            "bandit"
          ],
          "title": "Finding Tool",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "aegis.investigation_hypothesis/v1",
          "default": "aegis.investigation_hypothesis/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "source_line": {
          "minimum": 0,
          "title": "Source Line",
          "type": "integer"
        },
        "status": {
          "const": "hypothesis",
          "default": "hypothesis",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "case_id",
        "event_id",
        "finding_digest",
        "finding_tool",
        "finding_rule_id",
        "source_file",
        "source_line",
        "deployment_source_digest",
        "evidence_refs",
        "summary"
      ],
      "title": "InvestigationHypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "correlated_pairs": {
      "minimum": 0,
      "title": "Correlated Pairs",
      "type": "integer"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/InvestigationHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "schema_version": {
      "const": "aegis.correlation_report/v1",
      "default": "aegis.correlation_report/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "suspicious_events": {
      "minimum": 0,
      "title": "Suspicious Events",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "hypotheses",
    "suspicious_events",
    "correlated_pairs"
  ],
  "title": "CorrelationReport",
  "type": "object"
}
